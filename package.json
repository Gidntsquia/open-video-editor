{
  "name": "open-video-editor",
  "version": "0.1.0",
  "description": "Open-source Windows video editor for screen and game recordings",
  "type": "module",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/start.js",
    "electron": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node test/export.test.js && node test/ove.test.js && node test/trans.test.js && node test/mcp.test.js",
    "ove": "node cli/ove.js",
    "mcp": "node cli/mcp.js",
    "dist": "node scripts/dist.js",
    "icons": "electron scripts/make-icons.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.0",
    "electron-builder": "26.16.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.gidntsquia.open-video-editor",
    "productName": "Open Video Editor",
    "artifactName": "Open-Video-Editor-${version}-win-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "cli/**",
      "shared/**",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "extraFiles": [
      {
        "from": "packaging/win",
        "to": "."
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
